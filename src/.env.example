# Copy to src/.env and fill in. src/.env is gitignored — never commit real values.

# MinIO / S3 (MLflow artifact store)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
MINIO_USERNAME=minioadmin
MINIO_PASSWORD=minioadmin

# Postgres
POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_DB=airflow

# Airflow
AIRFLOW_UID=50000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Kafka (Confluent Cloud SASL_SSL). Leave USERNAME/PASSWORD empty for a local PLAINTEXT broker.
KAFKA_BOOTSTRAP_SERVERS=<your-cluster>.confluent.cloud:9092
KAFKA_USERNAME=<api-key>
KAFKA_PASSWORD=<api-secret>
KAFKA_TOPIC=transactions
KAFKA_OUTPUT_TOPIC=fraud_predictions
KAFKA_LEGIT_TOPIC=legit_predictions
KAFKA_SECURITY_PROTOCOL=SASL_SSL

# SMTP (MailDev in docker-compose)
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_FROM=fraud.alerts@example.com

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# Optional: public host:port of a VM running MLflow, e.g. 203.0.113.10:5500
MLFLOW_EXTRA_HOST=

# API keys (comma-separated). Empty = open API, local development only.
SCORING_API_KEYS=change-me-scoring-key
PRODUCER_API_KEYS=change-me-producer-key
# Client scripts in scripts/ send this key as X-API-Key
FRAUD_API_KEY=change-me-scoring-key

# Sync scoring: latency budget and behaviour when the model fails or is too slow.
# FALLBACK_MODE: review = fail safe (manual queue), approve = fail open (keep checkout working).
# Keep comments on their own lines: docker env_file does not strip trailing comments.
SCORING_TIMEOUT_MS=300
FALLBACK_MODE=review
