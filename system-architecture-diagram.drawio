          <mxGeometry x="320" y="80" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- Producer REST API -->
        <mxCell id="producer-api" value="Producer REST API&#xa;(FastAPI)&#xa;Port: 8000&#xa;&#xa;POST /predict&#xa;Kafka Integration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11" vertex="1" parent="1">
          <mxGeometry x="320" y="120" width="180" height="100" as="geometry" />
        </mxCell>

        <!-- Airflow -->
        <mxCell id="airflow" value="Apache Airflow&#xa;(ML Training Orchestration)&#xa;Port: 8080&#xa;&#xa;DAG: ieee_cis_fraud_detection_training&#xa;- Validate Environment&#xa;- Execute Training&#xa;- Cleanup Resources" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10" vertex="1" parent="1">
          <mxGeometry x="320" y="240" width="180" height="140" as="geometry" />
        </mxCell>

        <!-- Layer 3: Processing -->
        <mxCell id="layer3-title" value="Stream Processing &amp; ML Training" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="580" y="80" width="300" height="30" as="geometry" />
        </mxCell>

        <!-- Inference Service -->
        <mxCell id="inference" value="Inference Service&#xa;(Spark Structured Streaming)&#xa;&#xa;Features:&#xa;• Real-time scoring&#xa;• VAE Anomaly Detection&#xa;• Velocity Features&#xa;• Adaptive Threshold&#xa;• Model: XGBoost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left" vertex="1" parent="1">
          <mxGeometry x="580" y="120" width="220" height="140" as="geometry" />
        </mxCell>

        <!-- ML Training Pipeline -->
        <mxCell id="ml-training" value="ML Training Pipeline&#xa;(ieee_cis_training.py)&#xa;&#xa;1. Load &amp; Merge Data (590K rows)&#xa;2. Feature Engineering (49 features):&#xa;   • Velocity (1h, 6h, 24h, 7d)&#xa;   • Frequency Encoding&#xa;   • Email Risk Indicators&#xa;3. Train VAE Ensemble (3 models)&#xa;4. Train Boosting Models:&#xa;   • XGBoost (2000 trees)&#xa;   • LightGBM (5000 trees)&#xa;   • CatBoost (3000 iterations)&#xa;5. Calibrate Probabilities&#xa;6. Initialize Adaptive Threshold" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=9;align=left" vertex="1" parent="1">
          <mxGeometry x="580" y="280" width="220" height="220" as="geometry" />
        </mxCell>

        <!-- Layer 4: Storage -->
        <mxCell id="layer4-title" value="Storage &amp; Model Registry" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="860" y="80" width="250" height="30" as="geometry" />
        </mxCell>

        <!-- PostgreSQL -->
