{
  "test_scenarios": {
    "fraud_high_amount": {
      "description": "High-value transaction with risky email (should flag as fraud)",
      "expected_decision": "REVIEW or BLOCK",
      "expected_risk": "HIGH",
      "payload": {
        "TransactionID": "txn-fraud-amt-0001",
        "TransactionDT": 100100,
        "TransactionAmt": 25000.00,
        "ProductCD": "W",
        "card1": 4000000000000002,
        "card2": 222,
        "card3": 150,
        "card4": "mastercard",
        "card5": 88,
        "card6": "credit",
        "addr1": 400,
        "addr2": 500,
        "P_emaildomain": "mailinator.com",
        "R_emaildomain": "mailinator.com"
      }
    },
    "legitimate_normal": {
      "description": "Normal transaction with safe email (should approve)",
      "expected_decision": "APPROVE",
      "expected_risk": "LOW",
      "payload": {
        "TransactionID": "txn-legit-0001",
        "TransactionDT": 100200,
        "TransactionAmt": 25.50,
        "ProductCD": "W",
        "card1": 1234567890,
        "card2": 111,
        "card3": 150,
        "card4": "visa",
        "card5": 102,
        "card6": "debit",
        "addr1": 299,
        "addr2": 87,
        "P_emaildomain": "gmail.com",
        "R_emaildomain": "gmail.com"
      }
    },
    "velocity_spike_test": {
      "description": "Multiple rapid transactions (send 5x with same card, 1s apart)",
      "expected_decision": "REVIEW (on 4th-5th transaction)",
      "expected_risk": "MEDIUM to HIGH (escalates)",
      "payload_template": {
        "TransactionID": "txn-velocity-{i}",
        "TransactionDT": 100300,
        "TransactionAmt": 100.00,
        "ProductCD": "W",
        "card1": 9999999999,
        "card2": 333,
        "card3": 150,
        "card4": "visa",
        "card5": 226,
        "card6": "credit",
        "addr1": 315,
        "addr2": 87,
        "P_emaildomain": "gmail.com",
        "R_emaildomain": "yahoo.com"
      },
      "instructions": "Send this payload 5 times with incrementing TransactionID (txn-velocity-1, txn-velocity-2, etc.) with 1-second delays"
    },
    "fraud_low_amount": {
      "description": "Suspiciously low amount with risky email",
      "expected_decision": "REVIEW",
      "expected_risk": "MEDIUM",
      "payload": {
        "TransactionID": "txn-fraud-low-0001",
        "TransactionDT": 100400,
        "TransactionAmt": 0.50,
        "ProductCD": "W",
        "card1": 5555555555,
        "card2": 444,
        "card3": 150,
        "card4": "discover",
        "card5": 166,
        "card6": "credit",
        "addr1": 140,
        "addr2": 87,
        "P_emaildomain": "tempmail.com",
        "R_emaildomain": "tempmail.com"
      }
    },
    "fraud_email_mismatch": {
      "description": "Email domain mismatch + high amount",
      "expected_decision": "REVIEW",
      "expected_risk": "HIGH",
      "payload": {
        "TransactionID": "txn-fraud-mismatch-0001",
        "TransactionDT": 100500,
        "TransactionAmt": 15000.00,
        "ProductCD": "W",
        "card1": 7777777777,
        "card2": 555,
        "card3": 150,
        "card4": "amex",
        "card5": 224,
        "card6": "credit",
        "addr1": 204,
        "addr2": 87,
        "P_emaildomain": "anonymous.com",
        "R_emaildomain": "yopmail.com"
      }
    }
  },
  "curl_examples": {
    "fraud_high_amount": "curl -X POST http://localhost:8000/api/v1/transactions/submit -H 'Content-Type: application/json' -d '{\"TransactionID\":\"txn-fraud-amt-0001\",\"TransactionAmt\":25000.00,\"ProductCD\":\"W\",\"card1\":4000000000000002,\"card2\":222,\"P_emaildomain\":\"mailinator.com\",\"R_emaildomain\":\"mailinator.com\"}'",
    "legitimate_normal": "curl -X POST http://localhost:8000/api/v1/transactions/submit -H 'Content-Type: application/json' -d '{\"TransactionID\":\"txn-legit-0001\",\"TransactionAmt\":25.50,\"ProductCD\":\"W\",\"card1\":1234567890,\"card2\":111,\"P_emaildomain\":\"gmail.com\"}'",
    "velocity_spike_loop": "for i in {1..5}; do curl -X POST http://localhost:8000/api/v1/transactions/submit -H 'Content-Type: application/json' -d '{\"TransactionID\":\"txn-velocity-'$i'\",\"TransactionAmt\":100.00,\"card1\":9999999999,\"card2\":333,\"P_emaildomain\":\"gmail.com\"}'; sleep 1; done"
  }
}
