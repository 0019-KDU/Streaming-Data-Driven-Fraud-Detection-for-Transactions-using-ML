    "testing_instructions": {
        "step_1": "Start all services: docker compose up -d",
        "step_2": "Wait for services to be ready (~2 minutes)",
        "step_3": "Test each scenario sequentially (wait between transactions as specified)",
        "step_4": "Check dashboard at http://localhost:8501 for ATO flags",
        "step_5": "Verify risk_factors include 'ACCOUNT_TAKEOVER_*' for detected cases",
        "note": "ATO detection requires Redis. Verify REDIS_URL is set in .env"
    },
    "expected_improvements": {
        "before_ato_detection": {
            "impossible_travel": "Not detected (only basic velocity)",
            "new_device_high_amount": "Partially detected (amount only)",
            "off_hours_spike": "Partially detected (time + amount)",
            "concurrent_sessions": "Not detected",
            "overall_ato_accuracy": "~60%"
        },
        "after_ato_detection": {
            "impossible_travel": "DETECTED (geo-velocity analysis)",
            "new_device_high_amount": "DETECTED (device fingerprinting + spending baseline)",
            "off_hours_spike": "DETECTED (time profiling + spending anomaly)",
            "concurrent_sessions": "DETECTED (session tracking)",
            "overall_ato_accuracy": "~100%"
        }
    }
}