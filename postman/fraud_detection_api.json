{
  "info": {
    "name": "Fraud Detection API",
    "description": "REST API for submitting transactions to real-time fraud detection pipeline",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "API_BASE_URL",
      "value": "http://localhost:8000",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{API_BASE_URL}}/health",
          "host": ["{{API_BASE_URL}}"],
          "path": ["health"]
        },
        "description": "Check if the API is running and healthy"
      }
    },
    {
      "name": "Submit Transaction (Legit - Low Risk)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TransactionAmt\": 49.99,\n  \"ProductCD\": \"W\",\n  \"card1\": 12345,\n  \"card2\": 150,\n  \"addr1\": 204,\n  \"P_emaildomain\": \"gmail.com\",\n  \"R_emaildomain\": \"gmail.com\"\n}"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/submit",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "submit"]
        },
        "description": "Submit a low-risk legitimate transaction"
      }
    },
    {
      "name": "Submit Transaction (Fraud - High Risk)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TransactionAmt\": 5000.00,\n  \"ProductCD\": \"W\",\n  \"card1\": 99999,\n  \"card2\": 999,\n  \"addr1\": 999,\n  \"P_emaildomain\": \"mailinator.com\",\n  \"R_emaildomain\": \"tempmail.com\"\n}"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/submit",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "submit"]
        },
        "description": "Submit a high-risk fraudulent transaction (risky email domains, high amount)"
      }
    },
    {
      "name": "Submit Transaction (Medium Risk)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TransactionAmt\": 750.00,\n  \"ProductCD\": \"H\",\n  \"card1\": 54321,\n  \"card2\": 200,\n  \"addr1\": 500,\n  \"P_emaildomain\": \"yahoo.com\",\n  \"R_emaildomain\": \"hotmail.com\"\n}"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/submit",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "submit"]
        },
        "description": "Submit a medium-risk transaction"
      }
    },
    {
      "name": "Synchronous Scoring (Legit)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TransactionAmt\": 25.00,\n  \"ProductCD\": \"W\",\n  \"card1\": 11111,\n  \"P_emaildomain\": \"gmail.com\"\n}"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/score-sync",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "score-sync"]
        },
        "description": "Submit transaction and wait for immediate fraud score (sync)"
      }
    },
    {
      "name": "Synchronous Scoring (Fraud)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"TransactionAmt\": 9999.99,\n  \"ProductCD\": \"W\",\n  \"card1\": 88888,\n  \"card2\": 888,\n  \"addr1\": 888,\n  \"P_emaildomain\": \"anonymous.com\",\n  \"R_emaildomain\": \"10minutemail.com\"\n}"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/score-sync",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "score-sync"]
        },
        "description": "Submit high-risk transaction and expect BLOCK decision (sync)"
      }
    },
    {
      "name": "Batch Submit (Multiple Transactions)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "[\n  {\n    \"TransactionAmt\": 29.99,\n    \"ProductCD\": \"W\",\n    \"card1\": 10001,\n    \"P_emaildomain\": \"gmail.com\"\n  },\n  {\n    \"TransactionAmt\": 199.99,\n    \"ProductCD\": \"H\",\n    \"card1\": 10002,\n    \"P_emaildomain\": \"yahoo.com\"\n  },\n  {\n    \"TransactionAmt\": 4500.00,\n    \"ProductCD\": \"W\",\n    \"card1\": 10003,\n    \"P_emaildomain\": \"tempmail.com\"\n  }\n]"
        },
        "url": {
          "raw": "{{API_BASE_URL}}/api/v1/transactions/submit",
          "host": ["{{API_BASE_URL}}"],
          "path": ["api", "v1", "transactions", "submit"]
        },
        "description": "Note: Current API handles single transactions. For batch, loop through array in Postman pre-request script."
      }
    }
  ]
}
